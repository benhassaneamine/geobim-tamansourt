# ─────────────────────────────────────────────
#  GeoBIM Tamansourt — .gitignore
# ─────────────────────────────────────────────

# ── Restricted source data (ETAFAT / never commit) ──
*.las
*.laz
*.copc.laz
*.e57
*.pts
*.ptx
*.rcp
*.rcs
data/raw/
data/private/

# ── Autodesk Revit ──
*.rvt
*.rfa
*.rte
*.rft
*.0001.rvt
*.0002.rvt
*.rvt.[0-9][0-9][0-9][0-9]
Backup/
*_backup/
Revit_Journals/
*.slog
*.dwg
*.dxf
*.nwc
*.nwd

# ── IFC / openBIM (large exchange files) ──
*.ifc
*.ifczip
*.ifcxml
*.bcf
*.bcfzip

# ── GIS ──
*.gpkg
*.gpkg-shm
*.gpkg-wal
*.gdb/
*.sde
*.qgz~
*.qgs~
*.qgd
.qgis2/
*.shp
*.shx
*.dbf
*.prj
*.cpg
*.sbn
*.sbx
*.qix
*.lock
*.aprx.bak
Index/
scratch.gdb/

# ── Rasters / large imagery ──
*.tif
*.tiff
*.ecw
*.sid
*.img
*.jp2
!images/*.jpg
!images/*.png
!assets/*.svg

# ── Blender ──
*.blend
*.blend[0-9]
*.blend[0-9][0-9]

# ── LaTeX (dissertation build artefacts) ──
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.lof
*.log
*.lot
*.out
*.synctex.gz
*.toc
*.nav
*.snm
*.vrb
*.xdv

# ── Video (host on YouTube, not in Git) ──
*.mp4
*.mov
*.avi
*.mkv

# ── Archives ──
*.zip
*.rar
*.7z
*.tar.gz

# ── OS ──
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# ── Editors / IDE ──
.vscode/
.idea/
*.swp
*.swo
*~
.history/

# ── Node / tooling (if ever added) ──
node_modules/
package-lock.json
.cache/
dist/
.env
.env.local

# ── Python ──
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/

# ── Temporary ──
tmp/
temp/
*.tmp
*.bak
